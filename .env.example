# Google OAuth Web client ID (console.cloud.google.com -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
# Teacher emails allowed to manage students/lessons (comma separated)
TEACHER_EMAILS=teacher@gmail.com
# Long random string used to sign login cookies
SESSION_SECRET=change-me
PORT=3000
# Optional: automatic WhatsApp sending through WhatsApp Cloud API (Meta).
# If empty, the app opens a ready-to-send WhatsApp chat (wa.me) instead.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Local testing only (never in production): allows /api/dev-login?email=...
DEV_LOGIN=
